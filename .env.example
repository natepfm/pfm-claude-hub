# PFM Editors Hub — auth configuration
# Copy to .env.local for local dev. On Railway set these as service variables.
# NEVER commit real values.

# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production origin (Railway). Local dev can omit this.
# AUTH_URL=https://pfm-claude-hub-production.up.railway.app

# Custom hostname for the field lander, WITHOUT scheme or port.
# In production this is: ww2.savemaxagent.com  (neutral on purpose — the lander
# serves both the SaveMaxAuto and SaveMaxHomes skins, so the host names neither).
# Set it and that host serves the lander at "/" — a bare shared URL, no path, no login.
# Every other host (pfmhub.up.railway.app) is unaffected. Leave unset to change nothing.
# Read at build time — changing it on Railway requires a redeploy.
# LANDER_HOST=
